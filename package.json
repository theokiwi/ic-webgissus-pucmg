{
  "name": "ic-webgissus-pucmg",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter web start",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d db",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "rotas:preparar": "infra/valhalla/preparar.sh",
    "rotas:up": "docker compose -f infra/docker-compose.yml --profile rotas up -d valhalla",
    "rotas:down": "docker compose -f infra/docker-compose.yml --profile rotas stop valhalla",
    "build:vercel": "node infra/vercel/build.mjs",
    "deploy:vercel": "infra/vercel/deploy.sh",
    "banco:publicar": "infra/vercel/publicar-banco.sh",
    "divulgacao:qr": "node apps/web/scripts/gerar-qr-divulgacao.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "esbuild": "0.28.2",
    "vercel": "^65.15.0"
  }
}
